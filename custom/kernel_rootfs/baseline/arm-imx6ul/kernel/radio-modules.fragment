# SPDX-License-Identifier: GPL-3.0-or-later
# Radio drivers as MODULES for the rootfs (RADIO_MODULES=1, the default). Nothing loads them at boot:
# their only triggers are device modaliases (sdio:/of:), and nothing acts on those: no uevent helper,
# and the rootfs's mdev (USB sticks only) has no $MODALIAS rule. `radio up` loads them on demand.
# Symbols from LIVI scripts/livi-link/arm/imx6ul/build.sh (GPL-3.0-or-later), there built in.
# SERIAL_DEV_BUS/CTRL_TTYPORT must be built in for the serdev Bluetooth drivers (small).
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_CRDA_SUPPORT is not set
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_SDIO=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_8822BS=m
CONFIG_RTW88_8822CS=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PLTFM=m
CONFIG_MMC_SDHCI_ESDHC_IMX=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_RTL=m
CONFIG_BT_NXPUART=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
