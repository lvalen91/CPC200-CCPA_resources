# SPDX-License-Identifier: GPL-3.0-or-later
# CPC200-CCPA (i.MX6ULL, 128 MiB, 16 MiB QSPI NOR, vendor HAB U-Boot kept). POSIX sh. Sourced by
# baseline/build.sh on the build host and installed as /etc/baseline/board.env in the recovery
# initramfs and the rootfs. No unit identity in here: fuse words, MACs and serials are per unit and
# derived at runtime (common/shared/ocbm-identity) or read from the unit's backup by the host tool.
BOARD=arm-imx6ul
BOARD_NAME="CCPA baseline i.MX6ULL"
DTS_NAME=imx6ull-ccpa-baseline

# Build host side (ignored on the unit).
: "${CROSS_COMPILE:=arm-linux-gnu-}"       # LIVI's choice (Fedora cross gcc); any armv7 hard-float gcc
MUSL_TARGET=arm-linux-musleabihf
KARCH=arm

# Flash facts, hardware-verified 2026-10-19 (round_trip/RUNBOOK.txt, livi_9.5.0_iw416_dryrun_report.txt).
ERASE_SIZE=65536                 # 64 KiB erase blocks (MTD_SPI_NOR_USE_4K_SECTORS off)
KERNEL_FLASH_OFFSET=262144       # 0x40000
KERNEL_PART_SIZE=3407872         # 0x340000
KERNEL_MAX=3157976               # 0x302fd8: what the vendor U-Boot reads (norboot), zImage+DTB cap
STAGING_PART_OFFSET=3157976      # staged head at kernel+0x302fd8 (partition offset)
ENV_FLASH_OFFSET=196608          # 0x30000: the U-Boot env block, our 'env' MTD
ROOTFS_PART_SIZE=12976128        # 0xc60000
ERASED_BLOCK_SHA256=71189f7fb6aed638640078fba3a35fda6c39c8962e74dcc75935aac948da9063  # 64 KiB of 0xFF
ERASED_HEAD_SHA256=c1f7d702a80ae5e7dc52d62ef2577cbbb25c045d6dda3a49a872130518f48cc0   # 192 KiB of 0xFF

# Chip identity for ocbm-identity: OCOTP CFG0||CFG1, 8 raw bytes at nvmem offset 4.
: "${OCBM_NVMEM:=/sys/bus/nvmem/devices/imx-ocotp0/nvmem}"
: "${OCBM_CHIPID_OFFSET:=4}"
: "${OCBM_CHIPID_LEN:=8}"

# The UDC net-up binds: the controller behind the port the host sees (usbotg2). Matched on the
# sysfs path, because ci_hdrc.N numbering follows probe order and changes when usbotg1 is enabled.
NCM_UDC_MATCH=2184200.usb

# LEDs from the DT (gpio-leds labels).
LED_RED=/sys/class/leds/red
LED_BLUE=/sys/class/leds/blue
