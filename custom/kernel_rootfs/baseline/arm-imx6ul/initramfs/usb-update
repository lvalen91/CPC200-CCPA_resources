#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# usb-update: the last step of the recovery init in RECOVERY_USB=1 builds (the default). One-shot,
# bounded and quiet: it logs to /run/usb-update.log, writes to the console only when it is about to
# write flash or a started write failed, and never touches the UART, telnet or SSH shells.
#
#   1. usb-mount --wait 20: the first FAT32/exFAT data partition of a USB stick (the EFI System
#      Partition is skipped), mounted READ-WRITE at /mnt/usb and left mounted for the shells
#      (`flash-rootfs /mnt/usb/rootfs.img <sha256>`; `usb-mount -u` before pulling the stick).
#      A stick plugged in later is not seen: run `usb-mount` (no resident poller in recovery).
#   2. If the stick carries a bundle
#        ccpa-baseline/rootfs.img        + ccpa-baseline/rootfs.img.sha256       (sha256sum format)
#        ccpa-baseline/kernel-part.img   + ccpa-baseline/kernel-part.img.sha256  (stage_kernel.py output,
#                                                                                 staged for THIS unit)
#      the same helpers a shell would use run with --if-changed: rootfs first, the kernel only if the
#      rootfs step did not fail. An image already on flash (exit 3: the same bytes, or for the kernel
#      "already installed", i.e. U-Boot converted its staged head) and an image the helper refuses
#      (exit 4: nothing written) are logged only, so a stick left plugged in neither loops nor alarms.
#      It reboots only if it wrote something (after unmounting the stick).
LOG=/run/usb-update.log
exec >> "$LOG" 2>&1 < /dev/null
trap '' HUP PIPE
con() { echo "usb-update: $*" > /dev/console; echo "usb-update: $*"; }
echo "usb-update: start $(cat /proc/uptime)"

usb-mount --wait "${USB_UPDATE_WAIT:-20}" || { echo "usb-update: no USB stick mounted"; exit 0; }
B=/mnt/usb/ccpa-baseline
[ -d "$B" ] || { echo "usb-update: no ccpa-baseline/ bundle on the stick; /mnt/usb stays mounted"; exit 0; }
echo "usb-update: bundle at $B"

hash_of() { [ -r "$1" ] && read -r _h _rest < "$1" && echo "$_h"; }
wrote=

if [ -f "$B/rootfs.img" ]; then
    h=$(hash_of "$B/rootfs.img.sha256") || { echo "usb-update: rootfs.img without rootfs.img.sha256, skipped"; exit 0; }
    flash-rootfs --if-changed "$B/rootfs.img" "$h"
    case $? in
        0) wrote=1; con "rootfs written from USB" ;;
        3) echo "usb-update: rootfs already on flash" ;;
        4) echo "usb-update: rootfs.img refused (nothing written; /run/flash-rootfs.log); kernel step skipped"; exit 0 ;;
        *) con "rootfs write from USB failed (/run/flash-rootfs.log); repairable: retry flash-rootfs. Kernel step skipped"; exit 0 ;;
    esac
fi

if [ -f "$B/kernel-part.img" ]; then
    h=$(hash_of "$B/kernel-part.img.sha256") || { echo "usb-update: kernel-part.img without .sha256, skipped"; exit 0; }
    NO_REBOOT=1 flash-kernel --if-changed "$B/kernel-part.img" "$h"
    case $? in
        0) wrote=1; con "kernel written from USB" ;;
        3) echo "usb-update: kernel already on flash or already installed" ;;
        4) echo "usb-update: kernel-part.img refused (nothing written; /run/flash-kernel.log): stale, or staged for another unit" ;;
        *) con "kernel write from USB FAILED after it started (/run/flash-kernel.log). DO NOT POWER OFF until it is fixed"; exit 0 ;;
    esac
fi

if [ -n "$wrote" ]; then
    usb-mount -u
    con "rebooting in 5 s"
    sync
    sleep 5
    exec /bin/busybox reboot -f
fi
echo "usb-update: nothing written; /mnt/usb stays mounted"
exit 0
