#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Derived from LIVI scripts/livi-link/common/rootfs/init (https://github.com/f-io/LIVI,
# GPL-3.0-or-later). Changes: /dev and /run arrive moved from the recovery initramfs (mounted here
# only if they did not), /tmp is a tmpfs. PID-1 shim: pseudo filesystems, then busybox init.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config 2>/dev/null
exec /sbin/init
