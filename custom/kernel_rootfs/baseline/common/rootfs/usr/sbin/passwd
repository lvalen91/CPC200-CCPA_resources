#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# passwd [busybox passwd options] [USER]: busybox passwd (sha512-crypt by default, full.fragment), then
# keep the result across reboots. /etc/shadow is a link to /run/etc/shadow (the rootfs is a read-only
# squashfs, `persist load` seeds it); the new file is copied into the persist archive on the 'customer'
# MTD, which `persist load` in the rootfs AND in recovery uses from the next boot on. dropbear reads
# /etc/shadow at every login, so the new password is active immediately.
[ -s /run/etc/shadow ] || persist load > /dev/null
/bin/busybox passwd "$@" || exit $?
umask 077
mkdir -p /run/persist
cat /run/etc/shadow > /run/persist/shadow.new && mv /run/persist/shadow.new /run/persist/shadow || exit 1
if persist save; then
    echo "passwd: kept in the persist archive (rootfs and recovery)"
else
    echo "passwd: NOT saved to flash: the old password returns after a reboot" >&2
    exit 1
fi
