#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# usb-mount [ro|rw] / usb-mount -u: a USB stick on the host port at /mnt/usb. Only in builds with
# USB_HOST=1 (or RECOVERY_USB=1); nothing mounts storage at boot. The storage stack is modules
# (or built in, then modprobe just fails quietly).
if [ "$1" = -u ]; then
    umount /mnt/usb
    exit $?
fi
OPT=${1:-ro}
[ -d /sys/bus/usb ] || { echo "usb-mount: this kernel has no USB host support" >&2; exit 1; }
for m in usb-storage sd_mod vfat nls_cp437 nls_iso8859-1 nls_utf8 exfat; do
    modprobe -q "$m" 2>/dev/null
done
n=0
while [ "$n" -lt 10 ]; do
    for d in /dev/sd[a-z][0-9] /dev/sd[a-z]; do
        [ -b "$d" ] || continue
        if mount -o "$OPT" "$d" /mnt/usb 2>/dev/null; then
            echo "usb-mount: $d on /mnt/usb ($OPT)"
            exit 0
        fi
    done
    n=$((n + 1))
    sleep 1
done
echo "usb-mount: no mountable USB block device (dmesg)" >&2
exit 1
