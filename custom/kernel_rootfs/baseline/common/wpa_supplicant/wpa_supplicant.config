# wpa_supplicant 2.12 build configuration for the baselines (copied to wpa_supplicant/.config by
# common/recipes/userspace.sh build_wpa_supplicant, which appends the libnl include/library paths).
# Station only: WPA2-PSK (and WPA-PSK, open) through nl80211, the built-in ("internal") crypto, the UNIX
# control socket for wpa_cli. Nothing else.
#
# Deliberately NOT here:
#   SAE / WPA3, OWE, DPP: they need elliptic-curve crypto, which 2.12 implements only in
#                 src/crypto/crypto_openssl.c and crypto_wolfssl.c (crypto_ec_*); the internal crypto has
#                 none, so WPA3 would need a static OpenSSL or wolfSSL. Not cheap, not built (README §2.5).
#   EAP / 802.1X (enterprise), WPS, P2P, AP mode, mesh, TDLS, Hotspot 2.0, D-Bus, the wired and WEXT
#                 drivers, smartcards, syslog: not requested; each is code and attack surface.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_GETRANDOM=y
# wpa_cli line editing without readline
CONFIG_WPA_CLI_EDIT=y
# -f <file>: wifi-connect logs to /run/log/wpa_supplicant-<if>.log
CONFIG_DEBUG_FILE=y
