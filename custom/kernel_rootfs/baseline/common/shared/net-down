#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Based on LIVI by Lasse Heitgres (https://github.com/f-io/LIVI)
# Modified 2026-10-19: gadget name baseline, the interface name read back from configfs, pid files
# under /run, only our own udhcpd stopped. 2026-10-30: the OCBM accessory function (ocbm-accessory,
# its functionfs mount and /dev/usb_accessory) is taken down too.
# Derived from LIVI scripts/livi-link/common/initramfs/net-down (GPL-3.0-or-later).
# net-down: take the baseline USB gadget down again. Shells already running keep running.
G=/sys/kernel/config/usb_gadget/baseline
R=${OCBM_RUN:-/run/ocbm}
FFS=${OCBM_FFS_DIR:-$R/ffs}
IF=
[ -r "$G/functions/ncm.usb0/ifname" ] && read -r IF < "$G/functions/ncm.usb0/ifname"
if [ -d "$G" ]; then
    echo "" > "$G/UDC" 2>/dev/null
    rm -f "$G/configs/c.1/ncm.usb0" "$G/configs/c.1/acm.GS0" "$G/configs/c.1/ffs.ocbm"
fi
# OCBM: stop ocbm-accessory (it hangs ocbmd up and waits for it), then unmount functionfs; the
# ffs.ocbm function directory can only go once nothing holds the mount.
if [ -r /run/ocbm-accessory.pid ]; then
    kill "$(cat /run/ocbm-accessory.pid)" 2>/dev/null
    n=0
    while [ -r /run/ocbm-accessory.pid ] && [ "$n" -lt 60 ]; do n=$((n + 1)); sleep 0.1; done
    rm -f /run/ocbm-accessory.pid
fi
mountpoint -q "$FFS" 2>/dev/null && umount "$FFS" 2>/dev/null
[ -L /dev/usb_accessory ] && rm -f /dev/usb_accessory
if [ -d "$G" ]; then
    rmdir "$G/configs/c.1/strings/0x409" "$G/configs/c.1" "$G/functions/ncm.usb0" "$G/functions/acm.GS0" \
          "$G/functions/ffs.ocbm" "$G/strings/0x409" "$G" 2>/dev/null
fi
[ -r /run/udhcpd-ncm.pid ] && kill "$(cat /run/udhcpd-ncm.pid)" 2>/dev/null
rm -f /run/udhcpd-ncm.pid
[ -r /run/acm-shell.pid ] && kill "$(cat /run/acm-shell.pid)" 2>/dev/null
rm -f /run/acm-shell.pid
[ -n "$IF" ] && ifconfig "$IF" down 2>/dev/null
exit 0
