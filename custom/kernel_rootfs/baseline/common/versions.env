FW_RTL8822CS_BT="rtl_bt/rtl8822cs_fw.bin 42db5218c54b0638e1bafdbc7d0986172288e55a9e1c879080d41206bb87dfa2 20260916"
FW_RTL8822CS_BTCFG="rtl_bt/rtl8822cs_config.bin dbdc0a455f628337509afbdb6e1fb42e1622e3e876fc2aa962cc1b754709131c 20260916"
FW_RTL8822BS_WIFI="rtw88/rtw8822b_fw.bin a72da690597bfa99d8eb6fc2ab090d18d8ad92ac2befd35db1c9e3662d8d8418 20260916"
